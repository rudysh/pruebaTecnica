@model pruebaTecnica.ViewModels.ConsultaArticuloViewModel

@{
    ViewData["Title"] = "Consulta de artículos";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="mb-4">
                <h1 class="h2">Consulta de artículos</h1>

                <p class="text-muted">
                    Ingrese la referencia y el código de marca para
                    ejecutar el procedimiento almacenado.
                </p>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <form asp-controller="Articulos"
                          asp-action="Consultar"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="row">

                            <div class="col-md-5 mb-3">
                                <label asp-for="Referencia"
                                       class="form-label">
                                </label>

                                <input asp-for="Referencia"
                                       class="form-control"
                                       placeholder="Ejemplo: REF-001" />

                                <span asp-validation-for="Referencia"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-5 mb-3">
                                <label asp-for="CodigoMarca"
                                       class="form-label">
                                </label>

                                <input asp-for="CodigoMarca"
                                       class="form-control"
                                       placeholder="Ejemplo: MAR01" />

                                <span asp-validation-for="CodigoMarca"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-2 mb-3 d-flex align-items-end">

                                <button type="submit"
                                        class="btn btn-primary w-100">

                                    Consultar
                                </button>
                            </div>

                        </div>

                    </form>

                </div>
            </div>

            @if (ViewBag.Mensaje is not null)
            {
                <div class="alert alert-success">
                    @ViewBag.Mensaje
                </div>
            }

            @if (ViewBag.Error is not null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <strong>Artículos</strong>
                </div>

                <div class="card-body p-0">

                    @if (Model.Resultados.Count > 0)
                    {
                        <div class="table-responsive">

                            <table class="table table-striped table-hover mb-0">

                                <thead class="table-dark">
                                    <tr>
                                        <th>Código de barra</th>
                                        <th>Referencia</th>
                                        <th>Código de marca</th>
                                        <th>Nombre</th>
                                        <th class="text-end">
                                            Precio detalle
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (
                                   var articulo in Model.Resultados
                                   )
                                    {
                                        <tr>
                                            <td>
                                                @articulo.CodigoBarra
                                            </td>

                                            <td>
                                                @articulo.Referencia
                                            </td>

                                            <td>
                                                @articulo.CodigoMarca
                                            </td>

                                            <td>
                                                @articulo.Nombre
                                            </td>

                                            <td class="text-end">
                                                ₡ @articulo.PrecioDetal.ToString()
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            No hay información para mostrar.
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}